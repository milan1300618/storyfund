<UserDetailScreen>:
    name: "user_detail"

    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "10dp"

        MDLabel:
            text: "Darca"
            halign: "center"
            font_style: "H5"

        MDLabel:
            id: nik_label
            text: "NIK:"

        MDLabel:
            id: pin_label
            text: "PIN:"

        MDLabel:
            id: status_label
            text: "Stav:"

        MDLabel:
            id: stories_label
            text: "Príbehy v kole:"

        Widget:

        MDButton:
            id: block_btn
            MDButtonText:
                text: "🚫 Blokovaný"
            on_release: root.block_user()

        MDButton:
            id: unblock_btn
            MDButtonText:
                text: "🔓 Odblokovaný"
            on_release: root.unblock_user()

        MDButton:
            MDButtonText:
                text: "⬅ Späť"
            on_release: root.back()

<UsersScreen>:
    name: "users"

    MDBoxLayout:
        orientation: "vertical"
        padding: "16dp"
        spacing: "10dp"

        MDLabel:
            text: "Používatelia"
            halign: "center"
            font_style: "H5"

        MDTextField:
            id: search_field
            hint_text: "Hľadať podľa NIK..."
            on_text: root.filter_users(self.text)

        MDLabel:
            id: count_label
            text: "Používateľov: 0"

        ScrollView:
            MDList:
                id: users_list

        MDRaisedButton:
            text: "Späť do Admin panela"
            on_release: root.back()
